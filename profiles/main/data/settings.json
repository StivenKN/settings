{
  "editor.cursorBlinking": "phase",
  "editor.stickyScroll.enabled": false,
  "explorer.confirmDelete": false,
  "editor.guides.bracketPairs": "active",
  "editor.fontFamily": "CaskaydiaCove Nerd Font",
  "editor.fontLigatures": true,
  "editor.wordWrap": "on",
  "editor.formatOnSave": true,
  "git.enabled": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, .gitignore",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*"
  },
  "workbench.sideBar.location": "left",
  "window.density.editorTabHeight": "compact",
  "workbench.activityBar.location": "top",
  "window.menuBarVisibility": "compact",
  "workbench.colorTheme": "Catppuccin Mocha",
  "workbench.layoutControl.enabled": false,
  "workbench.editor.customLabels.enabled": true,
  "workbench.editor.customLabels.patterns": {
    "**/pages/**/*": "⚪ (${dirname}) ${filename}.${extname}",
    "**/components/**/*": "🟢 (${dirname}) ${filename}.${extname}",
    "**/utils/**/*": "🔵 ${filename}.${extname}",
  },
  "files.associations": {
    "*.module": "php"
  },
  "workbench.iconTheme": "symbols",
  "explorer.confirmDragAndDrop": false,
  "workbench.startupEditor": "none",
  "editor.minimap.enabled": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "Laravel.pint.runOnSave": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "workbench.panel.showLabels": false,
  "git.confirmSync": false,
  "inlineChat.affordance": "editor",
  "github.copilot.chat.searchSubagent.enabled": true,
  "github.copilot.chat.copilotMemory.enabled": true,
  "workbench.browser.openLocalhostLinks": true,
  "simpleBrowser.useIntegratedBrowser": true,
  "chat.tips.enabled": false,
  "chat.tools.global.autoApprove": true,
  "chat.exploreAgent.defaultModel": "Gemini 3 Flash (Preview) (copilot)",
}